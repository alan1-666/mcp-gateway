[Unit]
Description=MCP Gateway encrypted backup (local-only unless offhost configured)
Requires=docker.service
After=docker.service
ConditionPathExists=/opt/mcp-gateway/backup-key
[Service]
Type=oneshot
UMask=0077
EnvironmentFile=-/opt/mcp-gateway/backup.env
ExecStart=/bin/sh /opt/mcp-gateway/ops/backup.sh
TimeoutStartSec=1800
