[Unit]
Description=MCP Gateway health collection and configured alert delivery
Requires=docker.service
After=docker.service
ConditionPathExists=/opt/mcp-gateway/cloud.env
[Service]
Type=oneshot
UMask=0077
# Exit 2 means collection succeeded and evaluated alerts are present. Keep the
# alert JSON in the journal without misreporting a monitor execution failure.
SuccessExitStatus=2
EnvironmentFile=-/opt/mcp-gateway/monitor.env
ExecStart=/bin/sh /opt/mcp-gateway/ops/monitor.sh
TimeoutStartSec=60
