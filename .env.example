AUTH_MODE=token
# Cloud deployments use AUTH_MODE=cloud with an HTTPS PUBLIC_ORIGIN.
# See deploy/compose/cloud.yaml and docs/cloud-deployment.md.
DATABASE_URL=postgres://gateway:gateway@127.0.0.1:55432/gateway?sslmode=disable
GATEWAY_IDENTITIES_FILE=.local/identities.json
API_ADDR=127.0.0.1:8090
GATEWAY_ADDR=127.0.0.1:8091
GATEWAY_ALLOWED_ORIGINS=http://127.0.0.1:4782,http://localhost:4782
# Exact permitted downstream origins, comma-separated. Empty blocks all tools.
HTTP_ALLOWED_ORIGINS=
# Explicitly opt internal destination networks in. Link-local metadata stays blocked.
HTTP_ALLOWED_CIDRS=
# Optional private JSON file; see docs/development.md. Do not commit it.
GATEWAY_CREDENTIALS_FILE=
