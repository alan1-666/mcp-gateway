{
  "name": "@mcp-gateway/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4782 --strictPort",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4782 --strictPort",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=90 test/*.test.ts",
    "test:coverage:gateway": "node --import tsx --test --experimental-test-coverage --test-coverage-include=\"src/client-connection.ts\" --test-coverage-include=\"src/artifact-policy.ts\" --test-coverage-include=\"src/result-reader.ts\" --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 test/client-connection.test.ts test/artifact-policy.test.ts test/result-reader.test.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "vite": "7.3.6"
  }
}
